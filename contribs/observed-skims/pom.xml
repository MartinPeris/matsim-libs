<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<groupId>org.matsim</groupId>
		<artifactId>contrib</artifactId>
		<version>2027.0-SNAPSHOT</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.matsim.contrib</groupId>
	<artifactId>observed-skims</artifactId>

	<properties>
		<!-- Ratchet, not a target. Raise as coverage rises; never lower to make a build pass. -->
		<skims.coverage.minimum.line>0.78</skims.coverage.minimum.line>
		<skims.coverage.minimum.branch>0.67</skims.coverage.minimum.branch>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.matsim.contrib</groupId>
			<artifactId>common</artifactId>
			<version>${project.parent.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.inject</groupId>
			<artifactId>guice</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.matsim</groupId>
			<artifactId>matsim</artifactId>
			<version>${project.parent.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.matsim</groupId>
			<artifactId>matsim-examples</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
		Inert by design: no <activation> block, so nothing here runs in a normal build or in CI, and
		the module costs the 52-job matrix exactly what it did before. Invoke deliberately with
		-Pskims-quality, or through scripts/quality.sh.
	-->
	<profiles>
		<profile>
			<id>skims-quality</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.diffplug.spotless</groupId>
						<artifactId>spotless-maven-plugin</artifactId>
						<version>3.10.1</version>
						<configuration>
							<lineEndings>UNIX</lineEndings>
							<formats>
								<format>
									<includes>
										<include>src/main/java/**/*.java</include>
										<include>src/test/java/**/*.java</include>
									</includes>
									<trimTrailingWhitespace/>
									<endWithNewline/>
									<indent>
										<tabs>true</tabs>
										<spacesPerTab>4</spacesPerTab>
									</indent>
								</format>
							</formats>
						</configuration>
					</plugin>

					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-checkstyle-plugin</artifactId>
						<version>3.6.0</version>
						<configuration>
							<configLocation>${project.basedir}/quality/checkstyle.xml</configLocation>
							<consoleOutput>true</consoleOutput>
							<failOnViolation>true</failOnViolation>
							<includeTestSourceDirectory>true</includeTestSourceDirectory>
							<linkXRef>false</linkXRef>
						</configuration>
					</plugin>

					<plugin>
						<groupId>com.github.spotbugs</groupId>
						<artifactId>spotbugs-maven-plugin</artifactId>
						<version>4.10.4.0</version>
						<configuration>
							<effort>Min</effort>
							<threshold>High</threshold>
							<failOnError>true</failOnError>
							<excludeFilterFile>${project.basedir}/quality/spotbugs-exclude.xml</excludeFilterFile>
							<xmlOutput>true</xmlOutput>
						</configuration>
					</plugin>

					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>0.8.15</version>
						<executions>
							<execution>
								<id>skims-quality-prepare-agent</id>
								<goals>
									<goal>prepare-agent</goal>
								</goals>
							</execution>
							<execution>
								<id>skims-quality-report</id>
								<phase>verify</phase>
								<goals>
									<goal>report</goal>
								</goals>
							</execution>
							<execution>
								<id>skims-quality-check</id>
								<phase>verify</phase>
								<goals>
									<goal>check</goal>
								</goals>
								<configuration>
									<rules>
										<rule>
											<element>BUNDLE</element>
											<limits>
												<limit>
													<counter>LINE</counter>
													<value>COVEREDRATIO</value>
													<minimum>${skims.coverage.minimum.line}</minimum>
												</limit>
												<limit>
													<counter>BRANCH</counter>
													<value>COVEREDRATIO</value>
													<minimum>${skims.coverage.minimum.branch}</minimum>
												</limit>
											</limits>
										</rule>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
